# Copy to .env.local
# Values: Supabase Dashboard -> your project -> Connect (top bar),
# or Settings -> API Keys. Old projects may still show the legacy
# anon / service_role JWTs; both key formats work.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key: sb_publishable_... (legacy: anon JWT, eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_, never commit.
# Current: sb_secret_... (legacy: service_role JWT, eyJ...)
SUPABASE_SECRET_KEY=

# Any long random string. Salts the IP hash used for rate limiting.
# Generate: openssl rand -hex 32
IP_HASH_SALT=

# Server only. Google AI Studio Gemini API key for image + text moderation.
GEMINI_API_KEY=
